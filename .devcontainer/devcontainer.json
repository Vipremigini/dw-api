{
  "name": "DeepWriting Headless API",
  "image": "mcr.microsoft.com/devcontainers/python:3.10",
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "DeepWriting Headless API",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "git lfs pull && pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
